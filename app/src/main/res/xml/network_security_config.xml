<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Android cannot express a CIDR exception here. ServerUrlPolicy restricts
         cleartext to numeric Tailscale addresses and loopback before every
         client is created. HTTPS always uses platform certificate validation. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors><certificates src="system" /></trust-anchors>
    </base-config>
</network-security-config>
